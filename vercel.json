{
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.verkradar.is"
        }
      ],
      "destination": "https://verkradar.is/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "verkradar.vercel.app"
        }
      ],
      "destination": "https://verkradar.is/:path*",
      "permanent": true
    }
  ]
}
