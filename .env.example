# Browser-safe Supabase configuration. Never place the service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional Auth abuse protection. Both values are required before CAPTCHA appears.
VITE_AUTH_CAPTCHA_ENABLED=false
VITE_TURNSTILE_SITE_KEY=YOUR_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY
